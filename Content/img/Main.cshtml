            border-radius: 6px;
            font-size: 13.5px;
            color: var(--text, #0f172a);
            cursor: pointer;
        }

            .chip-dropdown-item:hover {
                background: var(--surface-hover, #f1f5f9);
            }

            .chip-dropdown-item.active {
                background: var(--accent-soft, #eef2ff);
                color: var(--accent, #4338ca);
                font-weight: 600;
            }

        .category-title {
            display: flex;
            align-items: baseline;
            gap: 8px;
        }

        .category-count {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-muted, #64748b);
        }

        .catalog-empty {
            text-align: center;
            color: var(--text-muted, #64748b);
            padding: 40px 0;
        }

        /* ---------- Product image + favourite button ---------- */
        .product-thumb {
            position: relative;
            isolation: isolate;
        }

            .product-thumb img {
                position: absolute;
                top: 0;
                left: 0;
                z-index: -1;
                width: 100%;
                height: 100%;
                box-sizing: border-box;
