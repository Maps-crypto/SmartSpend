            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
            object-fit: contain;
            padding: 2px;
            box-sizing: border-box;
        }

        .fav-btn {
            position: absolute;
            top: 8px;
            right: 8px;
            z-index: 2;
            width: 32px;
            height: 32px;
            padding: 0;
            border: none;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.92);
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
            color: #94a3b8;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

            .fav-btn svg {
                width: 18px;
                height: 18px;
                fill: none;
                stroke: currentColor;
                stroke-width: 2;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

            .fav-btn:hover {
                color: #e11d48;
            }

            .fav-btn.active {
                color: #e11d48;
            }

                .fav-btn.active svg {
                    fill: currentColor;
                }

            .fav-btn:disabled {
                opacity: 0.6;
                cursor: wait;
            }

            .fav-btn:focus-visible, .category-fab:focus-visible {
                outline: 2px solid #16a34a;
                outline-offset: 2px;
            }

        /* ---------- Add-to-cart button (bottom right, separate from favourite) ---------- */
        .add-btn {
            position: absolute;
            bottom: 8px;
            right: 8px;
            top: auto;
            left: auto;
            z-index: 2;
            width: 32px;
            height: 32px;
            padding: 0;
            border: none;
            border-radius: 50%;
            background: #16a34a;
            color: #fff;
            font-size: 18px;
            line-height: 1;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
            cursor: pointer;
        }

            .add-btn:hover {
                background: #15803d;
            }

            .add-btn:active {
                transform: scale(0.95);
            }

            .add-btn:focus-visible {
                outline: 2px solid #16a34a;
                outline-offset: 2px;
            }

        /* ---------- Product card right-click context menu ---------- */
        .card-context-menu {
            position: fixed;
            z-index: 50;
            min-width: 240px;
            background: var(--surface, #fff);
            border: 1px solid var(--border, #e2e8f0);
            border-radius: 10px;
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.18);
            padding: 4px;
        }

        .card-context-item {
            display: flex;
            align-items: center;
            gap: 8px;
            width: 100%;
            text-align: left;
            padding: 9px 10px;
            border: none;
            background: none;
            border-radius: 6px;
            font-size: 13.5px;
            font-family: inherit;
            color: var(--text, #0f172a);
            cursor: pointer;
        }

            .card-context-item svg {
                width: 16px;
                height: 16px;
                flex-shrink: 0;
                fill: none;
                stroke: currentColor;
                stroke-width: 2;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

            .card-context-item:hover {
                background: var(--surface-hover, #f1f5f9);
                color: #dc2626;
            }

        /* ---------- AI recommendations section ---------- */
        .ai-section {
            margin-bottom: 28px;
            scroll-margin-top: 90px;
        }

        .ai-tag {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.04em;
            padding: 2px 8px;
            border-radius: 999px;
            background: var(--accent-soft, #eef2ff);
            color: var(--accent, #4338ca);
        }

        .ai-subtitle {
            margin: -4px 0 12px;
            font-size: 13px;
            color: var(--text-muted, #64748b);
        }

        .ai-card {
            display: flex;
            flex-direction: column;
            height: auto;
        }

        .ai-reason {
            display: flex;
            align-items: flex-start;
            gap: 6px;
            margin-top: auto;
            padding: 8px 10px 10px;
            border-top: 1px solid var(--border, #e2e8f0);
            font-size: 12px;
            line-height: 1.35;
            color: var(--text-muted, #64748b);
        }

            .ai-reason img {
                width: 14px;
                height: 14px;
                flex-shrink: 0;
                margin-top: 1px;
                object-fit: contain;
            }

        .card-grid.is-loading .ai-card {
            opacity: 0.45;
            pointer-events: none;
            transition: opacity 0.15s ease;
        }

        .ai-reload-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 10px;
            min-height: 220px;
            padding: 16px;
            border: 2px dashed var(--border, #cbd5e1);
            border-radius: 14px;
            background: var(--surface, #fff);
            color: var(--text-muted, #64748b);
            font-family: inherit;
            font-size: 13.5px;
            font-weight: 600;
            text-align: center;
            cursor: pointer;
            transition: border-color 0.15s ease, color 0.15s ease;
        }

            .ai-reload-card img {
                width: 64px;
                height: 64px;
                object-fit: contain;
            }

            .ai-reload-card:hover:not(:disabled) {
                border-color: #16a34a;
                color: #16a34a;
            }

            .ai-reload-card:focus-visible {
                outline: 2px solid #16a34a;
                outline-offset: 2px;
            }

            .ai-reload-card:disabled {
                opacity: 0.6;
                cursor: wait;
            }

        .ai-empty {
            grid-column: 1 / -1;
            margin: 0;
            padding: 24px 0;
            text-align: center;
            color: var(--text-muted, #64748b);
        }

        /* Loading placeholders (not .product-card, so right-click / long-press ignore them) */
        .ai-skeleton {
            border: 1px solid var(--border, #e2e8f0);
            border-radius: 14px;
            overflow: hidden;
            background: var(--surface, #fff);
        }

            .ai-skeleton .sk-thumb {
                height: 150px;
            }

            .ai-skeleton .sk-body {
                padding: 12px;
            }

            .ai-skeleton .sk-line {
                display: block;
                height: 12px;
                margin-bottom: 8px;
                border-radius: 6px;
            }

                .ai-skeleton .sk-line.short {
                    width: 55%;
                }

            .ai-skeleton .sk-thumb,
            .ai-skeleton .sk-line {
                background: linear-gradient(90deg, #eef1f5 25%, #f8fafc 50%, #eef1f5 75%);
                background-size: 200% 100%;
                animation: ai-shimmer 1.3s linear infinite;
            }

        @@keyframes ai-shimmer {
            from {
                background-position: 200% 0;
            }

            to {
                background-position: -200% 0;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .ai-skeleton .sk-thumb,
            .ai-skeleton .sk-line {
                animation: none;
            }
        }

        /* ---------- Category FABs (middle right) ---------- */
        .category-fabs {
            position: fixed;
            right: 2px;
            top: 50%;
            transform: translateY(-50%);
            z-index: 30;
            display: flex;
            flex-direction: column;
            gap: 10px;
            max-height: 85vh;
            overflow-y: auto;
            padding: 10px 12px;
            scrollbar-width: none;
        }

            .category-fabs::-webkit-scrollbar {
                display: none;
            }

        .category-fab {
            width: 60px;
            height: 60px;
            padding: 0;
            border: 1px solid rgba(0, 0, 0, 0.08);
            border-radius: 50%;
            background: #fff;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.16);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            font-family: inherit;
            cursor: pointer;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }

            .category-fab:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 12px rgba(0, 0, 0, 0.22);
            }

            .category-fab:active {
                transform: scale(0.95);
            }

            .category-fab img {
                width: 35px;
                height: 35px;
                object-fit: contain;
                display: block;
                border-radius: 50%;
            }

        @@media (max-width: 480px) {
            .category-fabs {
                right: 0;
                padding: 8px;
                gap: 8px;
            }

            .category-fab {
                width: 34px;
                height: 34px;
            }

                .category-fab img {
                    width: 22px;
                    height: 22px;
                }
        }

        @@media (prefers-reduced-motion: reduce) {
            .category-fab {
                transition: none;
            }
        }
    </style>

    <script>

        if (!window.jQuery) {
            document.write('<scr' + 'ipt src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></scr' + 'ipt>');
        }
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.js"></script>

    <script>
        toastr.options = {
            "closeButton": false,
            "debug": false,
            "newestOnTop": false,
            "progressBar": true,
            "positionClass": "toast-top-full-width",
            "preventDuplicates": false,
            "showDuration": "300",
            "hideDuration": "1000",
            "timeOut": "10000",
            "extendedTimeOut": "1000",
            "showEasing": "swing",
            "hideEasing": "linear",
            "showMethod": "fadeIn",
            "hideMethod": "fadeOut"
        };

        $(function () {
            @if (TempData["Success"] != null)
            {
                <text>toastr.success(@Html.Raw(Json.Encode(TempData["Success"])));</text>
            }
        });
    </script>

}
