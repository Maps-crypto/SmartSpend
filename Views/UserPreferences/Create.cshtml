@model SmartSpend.Models.UserPreferences

@{
    ViewBag.Title = "Set Up Your Preferences";

    var dietaryOptions = new[] { "Vegetarian", "Vegan", "Lactose-Free", "Gluten-Free", "No Pork", "None" };
    var allergyOptions = new[] { "Nuts", "Shellfish", "Dairy", "Eggs", "Gluten", "None" };
    var productStyleOptions = new[] { "Store-brand/budget", "Name-brand only", "No preference" };
    var cookingOptions = new[] { "Quick Meals (under 15 min)", "Meal Prep Friendly", "Ready-to-Eat/No Cooking", "Enjoy Cooking" };
    var lifestyleOptions = new[] { "Gym/Fitness", "Gaming", "Studying/Academics", "Reading", "Sports", "Music" };
    var notificationOptions = new[] { "Weekly Budget Summary", "Low-Budget Alerts", "Meal Reminders", "New Deals/Recommendations" };
}

@* ----

    ------ Razor helpers (icons + chip groups) ---------- *@

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SmartSpend — Register</title>
    <link rel="icon" type="image/png" href="@Url.Content("~/Content/img/wallet.png")" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/authStyle.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.css" rel="stylesheet" />
</head>

@helper CheckIcon()
{
    <svg class="sp-check" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
}

@helper ChipGroup(string field, string[] options, string mode, string labelledBy, string exclusive = null, string chipClass = "")
{
    <div class="sp-chips" role="group" aria-labelledby="@labelledBy" data-field="@field" data-mode="@mode" data-exclusive="@exclusive">
        @foreach (var option in options)
        {
            <button type="button"
                    class="sp-chip @chipClass @(option == exclusive ? "sp-chip--none" : "")"
                    data-value="@option"
                    aria-pressed="false">
                @CheckIcon()<span>@option</span>
            </button>
        }
    </div>
}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />

<style>
    .sp-page {
        --sp-green: #006e4f;
        --sp-green-dark: #005a41;
        --sp-ink: #10233a;
        --sp-muted: #3d4a5c;
        --sp-chip-bg: #e3ecfb;
        --sp-chip-bg-hover: #d6e3f8;
        --sp-chip-border: #b6c4d8;
        --sp-input-bg: #f7f8fd;
        --sp-input-border: #c9d0e0;
        --sp-blue-card-bg: #d1e1ff;
        --sp-blue-card-border: #5b9cf0;
        --sp-blue-ink: #0d3a80;
        --sp-red-card-bg: #ffd6d5;
        --sp-red: #c00000;
        --sp-red-ink: #b30000;
        font-family: 'Inter', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        color: var(--sp-ink);
        max-width: 960px;
        margin: 0 auto;
        padding: 0 0 8px;
    }

        .sp-page * {
            box-sizing: border-box;
        }

    /* Header */
    .sp-header {
        padding: 4px 0 12px;
        border-bottom: 1px solid #e3e8f4;
        margin-bottom: 8px;
    }

    .sp-title {
        margin: 0;
        font-size: 24px;
        line-height: 1.2;
        font-weight: 700;
        color: var(--sp-green);
    }

    .sp-subtitle {
        margin: 6px 0 0;
        font-size: 13px;
        color: var(--sp-muted);
    }

    /* Sections */
    .sp-section {
        margin: 22px 0 0;
    }

    .sp-section-title {
        margin: 0 0 8px;
        font-size: 18px;
        line-height: 1.3;
        font-weight: 600;
        color: var(--sp-ink);
    }

    .sp-help {
        margin: -4px 0 10px;
        font-size: 11px;
        color: var(--sp-muted);
    }

    /* Text input with icon */
    .sp-input-wrap {
        position: relative;
    }

        .sp-input-wrap svg {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #5b6472;
            pointer-events: none;
        }

        .sp-input-wrap .sp-input {
            display: block;
            width: 100%;
            height: 50px;
            padding: 0 16px 0 44px;
            font: inherit;
            font-size: 16px;
            color: var(--sp-ink);
            background: var(--sp-input-bg);
            border: 1px solid var(--sp-input-border);
            border-radius: 10px;
            box-shadow: none;
            transition: border-color .15s, box-shadow .15s;
        }

            .sp-input-wrap .sp-input::placeholder {
                color: #6b7280;
            }

            .sp-input-wrap .sp-input:focus {
                outline: none;
                border-color: var(--sp-green);
                box-shadow: 0 0 0 3px rgba(0, 110, 79, .18);
            }

    /* Map preview under the address box */
    .sp-map {
        margin-top: 12px;
        border: 1px solid var(--sp-input-border);
        border-radius: 10px;
        overflow: hidden;
    }

    .sp-map__canvas {
        width: 100%;
        height: 240px;
    }

    /* Google's suggestion dropdown: keep it above the sticky save bar */
    .pac-container {
        z-index: 1100;
        font-family: 'Inter', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    /* Segmented toggle (Weekly / Monthly) */
    .sp-seg {
        display: flex;
        padding: 3px;
        gap: 0;
        background: var(--sp-chip-bg);
        border: 1px solid var(--sp-chip-border);
        border-radius: 999px;
    }

    .sp-seg__btn {
        flex: 1 1 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 42px;
        padding: 0 16px;
        margin: 0;
        font: inherit;
        font-size: 15px;
        font-weight: 500;
        color: var(--sp-blue-ink);
        background: transparent;
        border: 0;
        border-radius: 999px;
        cursor: pointer;
        transition: background-color .15s, color .15s;
    }

        .sp-seg__btn:hover {
            background: rgba(0, 0, 0, .04);
        }

        .sp-seg__btn.is-selected {
            background: var(--sp-green);
            color: #fff;
            font-weight: 500;
        }

        .sp-seg__btn .sp-check {
            display: none;
        }

        .sp-seg__btn.is-selected .sp-check {
            display: inline-block;
        }

    /* Chips (shared) */
    .sp-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .sp-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: 40px;
        padding: 0 16px;
        margin: 0;
        font: inherit;
        font-size: 15px;
        font-weight: 400;
        line-height: 1;
        color: var(--sp-ink);
        background: var(--sp-chip-bg);
        border: 1px solid var(--sp-chip-border);
        border-radius: 999px;
        cursor: pointer;
        white-space: nowrap;
        transition: background-color .15s, border-color .15s, color .15s, box-shadow .15s;
    }

        .sp-chip:hover {
            background: var(--sp-chip-bg-hover);
        }

        .sp-chip .sp-check {
            display: none;
            flex: none;
        }

        .sp-chip.is-selected .sp-check {
            display: inline-block;
        }

        .sp-chip.is-selected {
            background: #fff;
            border-color: #6b7a90;
            box-shadow: 0 0 0 1px #6b7a90;
        }

        .sp-chip:focus-visible, .sp-seg__btn:focus-visible, .sp-submit:focus-visible {
            outline: 3px solid rgba(0, 110, 79, .45);
            outline-offset: 2px;
        }

    /* Small chips (Hobbies & Lifestyle) */
    .sp-chip--sm {
        height: 26px;
        padding: 0 12px;
        font-size: 11px;
        font-weight: 500;
        gap: 6px;
    }

        .sp-chip--sm .sp-check {
            width: 11px;
            height: 11px;
        }

    /* Dietary card */
    .sp-card {
        position: relative;
        overflow: hidden;
        margin: 22px 0 0;
        padding: 16px;
        border-radius: 8px;
    }

    .sp-card__title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 8px;
        font-size: 18px;
        font-weight: 700;
    }

        .sp-card__title svg {
            flex: none;
        }

    .sp-card__note {
        margin: -2px 0 10px;
        font-size: 11px;
    }

    .sp-card__watermark {
        position: absolute;
        top: 12px;
        right: 16px;
        opacity: .14;
        pointer-events: none;
    }

    .sp-card--dietary {
        background: var(--sp-blue-card-bg);
        border: 1px solid var(--sp-blue-card-border);
    }

        .sp-card--dietary .sp-card__title {
            color: var(--sp-blue-ink);
        }

        .sp-card--dietary .sp-card__watermark {
            color: var(--sp-blue-ink);
        }

        .sp-card--dietary .sp-chip {
            background: #fff;
            border-color: #5c6675;
        }

            .sp-card--dietary .sp-chip:hover {
                background: #f1f6ff;
            }

            .sp-card--dietary .sp-chip.is-selected {
                background: #fff;
                border-color: var(--sp-blue-ink);
                box-shadow: 0 0 0 1px var(--sp-blue-ink);
            }

    /* Allergies card */
    .sp-card--allergy {
        background: var(--sp-red-card-bg);
        border: 1px solid var(--sp-red);
    }

        .sp-card--allergy .sp-card__title {
            color: var(--sp-red-ink);
        }

        .sp-card--allergy .sp-card__note {
            color: var(--sp-red-ink);
        }

        .sp-card--allergy .sp-chip {
            background: #fff;
            border-color: var(--sp-red);
            color: var(--sp-ink);
        }

            .sp-card--allergy .sp-chip:hover {
                background: #fff2f2;
            }

            .sp-card--allergy .sp-chip.is-selected {
                background: var(--sp-red);
                border-color: var(--sp-red);
                box-shadow: none;
                color: #fff;
            }

        .sp-card--allergy .sp-chip--none {
            border-color: #7b7b7b;
        }

            .sp-card--allergy .sp-chip--none.is-selected {
                background: #fff;
                border-color: #7b7b7b;
                box-shadow: 0 0 0 1px #7b7b7b;
                color: var(--sp-ink);
            }

    /* Footer / save bar */
    .sp-footer {
        position: sticky;
        bottom: 0;
        z-index: 5;
        margin-top: 28px;
        padding: 14px 0 10px;
        background: #fff;
        border-top: 1px solid #e3e8f4;
        text-align: center;
    }

    .sp-submit {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        height: 48px;
        margin: 0;
        font: inherit;
        font-size: 15px;
        font-weight: 500;
        color: #fff;
        background: var(--sp-green);
        border: 0;
        border-radius: 8px;
        cursor: pointer;
        transition: background-color .15s;
    }

        .sp-submit:hover {
            background: var(--sp-green-dark);
        }

    .sp-footer__note {
        margin: 8px 0 0;
        font-size: 11px;
        color: var(--sp-muted);
    }

    .sp-page .text-danger {
        display: block;
        margin-top: 6px;
        font-size: 12px;
    }

    @@media (max-width: 480px) {
        .sp-title {
            font-size: 21px;
        }

        .sp-chip {
            height: 38px;
            padding: 0 14px;
            font-size: 14px;
        }

        .sp-chip--sm {
            height: 26px;
            padding: 0 12px;
            font-size: 11px;
        }

        .sp-card__watermark {
            display: none;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .sp-page * {
            transition: none !important;
        }
    }
</style>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="sp-page">
        <div class="sp-header">
            <h1 class="sp-title">Set Up Your Preferences</h1>
            <p class="sp-subtitle">This helps us personalize your recommendations and budget</p>
        </div>

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        @* ---------------- Location ---------------- *@
        <div class="sp-section">
            <label class="sp-section-title" for="Address" style="display:block;">Location</label>
            <p class="sp-help">Used to estimate store distance and transport cost</p>
            <div class="sp-input-wrap">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                    <circle cx="12" cy="10" r="3" />
                </svg>
                @Html.TextBoxFor(model => model.Address, new { @class = "sp-input", placeholder = "Enter your address", autocomplete = "off" })
            </div>
            @Html.ValidationMessageFor(model => model.Address, "", new { @class = "text-danger" })

            @* Map preview: stays hidden until an address is picked from the suggestions *@
            <div class="sp-map" id="sp-map-wrap" hidden>
                <div class="sp-map__canvas" id="sp-map" role="img" aria-label="Map showing the selected address"></div>
            </div>
        </div>

        @* ---------------- Shopping frequency ---------------- *@
        <div class="sp-section">
            <div class="sp-section-title" id="lbl-frequency">Shopping Frequency</div>
            @Html.HiddenFor(model => model.ShoppingFrequency)
            <div class="sp-seg" role="group" aria-labelledby="lbl-frequency"
                 data-field="ShoppingFrequency" data-mode="single" data-default="Weekly">
                <button type="button" class="sp-seg__btn" data-value="Weekly" aria-pressed="false">@CheckIcon()<span>Weekly</span></button>
                <button type="button" class="sp-seg__btn" data-value="Monthly" aria-pressed="false">@CheckIcon()<span>Monthly</span></button>
            </div>
            @Html.ValidationMessageFor(model => model.ShoppingFrequency, "", new { @class = "text-danger" })
        </div>

        @* ---------------- Dietary needs ---------------- *@
        <div class="sp-card sp-card--dietary">
            <svg class="sp-card__watermark" viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m16 2-2.3 2.3a3 3 0 0 0 0 4.2l1.8 1.8a3 3 0 0 0 4.2 0L22 8" />
                <path d="M15 15 3.3 3.3a4.2 4.2 0 0 0 0 6l7.3 7.3c.7.7 2 .7 2.8 0L15 15Zm0 0 7 7" />
                <path d="m2.1 21.8 6.4-6.3" />
                <path d="m19 5-7 7" />
            </svg>
            <div class="sp-card__title" id="lbl-dietary">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m3 17 2 2 4-4" />
                    <path d="m3 7 2 2 4-4" />
                    <path d="M13 6h8" />
                    <path d="M13 12h8" />
                    <path d="M13 18h8" />
                </svg>
                Dietary Needs
            </div>
            @Html.HiddenFor(model => model.DietaryNeeds)
            @ChipGroup("DietaryNeeds", dietaryOptions, "multi", "lbl-dietary", exclusive: "None")
            @Html.ValidationMessageFor(model => model.DietaryNeeds, "", new { @class = "text-danger" })
        </div>

        @* ---------------- Allergies ---------------- *@
        <div class="sp-card sp-card--allergy">
            <div class="sp-card__title" id="lbl-allergies">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
                    <path d="M12 9v4" />
                    <path d="M12 17h.01" />
                </svg>
                Allergies
            </div>
            <p class="sp-card__note">Select to avoid these items</p>
            @Html.HiddenFor(model => model.Allergies)
            @ChipGroup("Allergies", allergyOptions, "multi", "lbl-allergies", exclusive: "None")
            @Html.ValidationMessageFor(model => model.Allergies, "", new { @class = "text-danger" })
        </div>

        @* ---------------- Product style ---------------- *@
        <div class="sp-section">
            <div class="sp-section-title" id="lbl-product">Product Style</div>
            @Html.HiddenFor(model => model.ProductStyle)
            @ChipGroup("ProductStyle", productStyleOptions, "single", "lbl-product")
            @Html.ValidationMessageFor(model => model.ProductStyle, "", new { @class = "text-danger" })
        </div>

        @* ---------------- Cooking style ---------------- *@
        <div class="sp-section">
            <div class="sp-section-title" id="lbl-cooking">Cooking Style</div>
            @Html.HiddenFor(model => model.CookingStyle)
            @ChipGroup("CookingStyle", cookingOptions, "multi", "lbl-cooking")
            @Html.ValidationMessageFor(model => model.CookingStyle, "", new { @class = "text-danger" })
        </div>

        @* ---------------- Hobbies & lifestyle ---------------- *@
        <div class="sp-section">
            <div class="sp-section-title" id="lbl-lifestyle">Hobbies &amp; Lifestyle</div>
            @Html.HiddenFor(model => model.Lifestyle)
            @ChipGroup("Lifestyle", lifestyleOptions, "multi", "lbl-lifestyle", chipClass: "sp-chip--sm")
            @Html.ValidationMessageFor(model => model.Lifestyle, "", new { @class = "text-danger" })
        </div>

        @* ---------------- Notifications ---------------- *@
        <div class="sp-section">
            <div class="sp-section-title" id="lbl-notifications">Notifications</div>
            @Html.HiddenFor(model => model.Notifications)
            @ChipGroup("Notifications", notificationOptions, "multi", "lbl-notifications")
            @Html.ValidationMessageFor(model => model.Notifications, "", new { @class = "text-danger" })
        </div>

        @* ---------------- Save bar ---------------- *@
        <div class="sp-footer">
            <button type="submit" class="sp-submit">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z" />
                    <path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7" />
                    <path d="M7 3v4a1 1 0 0 0 1 1h7" />
                </svg>
                Save Preferences
            </button>
            <p class="sp-footer__note">You can update these anytime from your Profile</p>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        // The chip groups above store their selected value(s) in hidden inputs.
        // jQuery Validate ignores :hidden fields by default. jquery.validate.unobtrusive
        // (loaded in the bundle above) queues its own $(document).ready parse() call that
        // builds the validator using whatever defaults are set at that point, so this
        // override must run synchronously here - NOT inside another $(function(){...}) -
        // or it fires too late and hidden fields keep getting skipped.
        $.validator.setDefaults({ ignore: "" });

        // jQuery Validate triggers this on the form whenever the user tries to
        // submit while something is still invalid - fires immediately, before
        // any server round trip.
        $(function () {
            $('form').on('invalid-form', function () {
                toastr.error('Please fill in all details before saving.');
            });
        });
    </script>

    <script>
        // Address autocomplete + map preview (Google Maps Platform)
        function initSpAddress() {
            var input = document.getElementById('Address');
            if (!input) { return; }

            var wrap = document.getElementById('sp-map-wrap');
            var canvas = document.getElementById('sp-map');

            Promise.all([
                google.maps.importLibrary('maps'),
                google.maps.importLibrary('places'),
                google.maps.importLibrary('marker')
            ]).then(function (libs) {
                var MapCtor = libs[0].Map;
                var Autocomplete = libs[1].Autocomplete;
                var Marker = libs[2].AdvancedMarkerElement;
                var map = null;
                var marker = null;

                var autocomplete = new Autocomplete(input, {
                    types: ['address'],
                    fields: ['formatted_address', 'geometry', 'name']
                    // , componentRestrictions: { country: 'za' }   // uncomment to limit suggestions to one country
                });

                autocomplete.addListener('place_changed', function () {
                    var place = autocomplete.getPlace();
                    if (!place.geometry || !place.geometry.location) { return; }

                    if (place.formatted_address) { input.value = place.formatted_address; }

                    wrap.hidden = false;   // reveal before creating the map so it gets a real size

                    if (!map) {
                        map = new MapCtor(canvas, {
                            center: place.geometry.location,
                            zoom: 17,
                            mapId: 'DEMO_MAP_ID',
                            mapTypeControl: false,
                            streetViewControl: false,
                            fullscreenControl: false
                        });
                        marker = new Marker({ map: map, position: place.geometry.location });
                    } else {
                        map.setCenter(place.geometry.location);
                        map.setZoom(17);
                        marker.position = place.geometry.location;
                    }
                });

                // Enter should pick the highlighted suggestion, not submit the form
                input.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') { e.preventDefault(); }
                });
            });
        }
    </script>
    <script async defer
            src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAMwVtOUI3bvh-ilrxRpkQvfv9O5IV6kDk&libraries=places,marker&loading=async&callback=initSpAddress"></script>

    <script>
        (function () {
            // Defaults used only when the model has no saved value yet
            var defaults = {
                ShoppingFrequency: 'Weekly',
                Allergies: 'None',
                ProductStyle: 'No preference'
            };

            var groups = document.querySelectorAll('[data-field]');

            Array.prototype.forEach.call(groups, function (group) {
                var field = group.getAttribute('data-field');
                var input = document.getElementById(field);
                if (!input) { return; }

                var single = group.getAttribute('data-mode') === 'single';
                var exclusive = group.getAttribute('data-exclusive');
                var buttons = Array.prototype.slice.call(group.querySelectorAll('button[data-value]'));

                var raw = (input.value || '').trim();
                if (!raw && defaults[field]) { raw = defaults[field]; }

                var selected = raw ? raw.split(',').map(function (s) { return s.trim(); }).filter(Boolean) : [];

                function render() {
                    buttons.forEach(function (btn) {
                        var on = selected.indexOf(btn.getAttribute('data-value')) > -1;
                        btn.classList.toggle('is-selected', on);
                        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
                    });
                    input.value = selected.join(',');
                    if (window.jQuery && jQuery.data(input.form, 'validator')) {
                        jQuery(input).valid();
                    }
                }

                buttons.forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        var value = btn.getAttribute('data-value');
                        var index = selected.indexOf(value);

                        if (single) {
                            selected = [value];
                        } else if (index > -1) {
                            selected.splice(index, 1);
                        } else if (exclusive && value === exclusive) {
                            selected = [value];                       // "None" clears everything else
                        } else {
                            selected = selected.filter(function (v) { return v !== exclusive; });
                            selected.push(value);                     // picking anything clears "None"
                        }
                        render();
                    });
                });

                render();
            });
        })();
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.js"></script>

    <script>
    toastr.options = {
        "closeButton": false,
        "debug": false,
        "newestOnTop": false,
        "progressBar": true,
        "positionClass": "toast-top-full-width",
        "preventDuplicates": false,
        "showDuration": "300",
        "hideDuration": "1000",
        "timeOut": "10000",
        "extendedTimeOut": "1000",
        "showEasing": "swing",
        "hideEasing": "linear",
        "showMethod": "fadeIn",
        "hideMethod": "fadeOut"
    };

    @if (TempData["Success"] != null)
    {
        <text>toastr.success(@Html.Raw(Json.Encode(TempData["Success"])));</text>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <text>toastr.error("Please fill in all details before saving.");</text>
    }
    </script>
}

