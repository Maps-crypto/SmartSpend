<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SafeSpend — Register</title>
    <link rel="icon" type="image/png" href="@Url.Content("~/Content/img/wallet.png")" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/authStyle.css">
</head>
<body>
    <div class="auth-wrapper">
        <div class="brand">
            <div class="brand-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="6" width="14" height="12" rx="2" />
                    <path d="M6 6V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-2" />
                </svg>
            </div>
            <p class="brand-name">SafeSpend</p>
            <h1 class="auth-heading">Create Your Account</h1>
            <p class="auth-subtitle">Start managing your food budget smarter</p>
        </div>

        <div class="auth-card">
            <form id="register-form" method="post" action="/Account/Register" novalidate>
                <div class="field">
                    <label for="register-username">Username</label>
                    <div class="input-group">
                        <input type="text" id="register-username" name="username" placeholder="Enter username" required>
                    </div>
                </div>

                <div class="field">
                    <label for="register-email">Email</label>
                    <div class="input-group">
                        <input type="email" id="register-email" name="email" placeholder="name@example.com" required>
                    </div>
                </div>

                <div class="field">
                    <label for="register-password">Password</label>
                    <div class="input-group has-toggle">
                        <input type="password" id="register-password" name="password" placeholder="Create a password" required minlength="8">
                        <button type="button" class="toggle-visibility" data-target="register-password" aria-label="Show password"></button>
                    </div>
                </div>

                <div class="field">
                    <label for="register-confirm">Confirm Password</label>
                    <div class="input-group has-toggle">
                        <input type="password" id="register-confirm" name="confirmPassword" placeholder="Re-enter your password" required>
                        <button type="button" class="toggle-visibility" data-target="register-confirm" aria-label="Show password"></button>
                    </div>
                    <div class="error-message">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="8" x2="12" y2="12" />
                            <line x1="12" y1="16" x2="12.01" y2="16" />
                        </svg>
                        Passwords do not match
                    </div>
                </div>

                <div style="margin-top: 22px;">
                    <button type="submit" class="btn-primary">Create Account</button>
                </div>
            </form>

            <p class="switch-auth">Already have an account? <a href="login.html" class="link">Log In</a></p>
        </div>
    </div>

    <script src="~/Scripts/authScript.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
