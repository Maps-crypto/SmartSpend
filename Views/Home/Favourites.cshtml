@model SmartSpend.Models.FavouritesViewModel
@{
    ViewBag.Title = "Favourites";
    Layout = "~/Views/Shared/favlay.cshtml";
}

<!-- ===== FAVOURITES BODY ===== -->
<div class="page-body">

    <div id="fav-token" style="display:none">@Html.AntiForgeryToken()</div>

    <section class="category-section" id="fav-section">
        <h2 class="section-title category-title">
            Favourites <span class="category-count" id="fav-count">@Model.Items.Count</span>
        </h2>

        @if (Model.Items.Count == 0)
        {
            <p class="catalog-empty" id="fav-empty">You haven't favourited anything yet. Tap the heart on a product in the catalogue to save it here.</p>
        }
        else
        {
            <div class="card-grid" id="fav-grid">
                @foreach (var item in Model.Items)
                {
                    <div class="product-card">
                        <div class="product-thumb">
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.style.display='none'" />
                            }
                            <button type="button" class="fav-btn active"
                                    data-id="@(item.ScrapedItemId.HasValue ? item.ScrapedItemId.Value.ToString() : "")"
                                    data-favorite-id="@item.FavoriteId"
                                    aria-pressed="true"
                                    aria-label="Remove @item.Title from favourites">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z" /></svg>
                            </button>
                        </div>
                        <div class="product-info">
                            <span class="product-name">@item.Title</span>
                            <span class="product-price">@("R" + item.Price) <span class="store">@item.Retailer</span></span>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <section class="category-section" id="disliked-section">
        <h2 class="section-title category-title">
            Hidden Products <span class="category-count" id="disliked-count">@Model.Dislikes.Count</span>
        </h2>

        @if (Model.Dislikes.Count == 0)
        {
            <p class="catalog-empty" id="disliked-empty">You haven't hidden any products yet. Right-click (or long-press) a product in the catalogue and choose "I don't want to see this product again".</p>
        }
        else
        {
            <div class="card-grid" id="disliked-grid">
                @foreach (var item in Model.Dislikes)
                {
                    <div class="product-card">
                        <div class="product-thumb">
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.style.display='none'" />
                            }
                            <button type="button" class="undislike-btn"
                                    data-disliked-id="@item.DislikedItemId"
                                    aria-label="Show @item.Title again">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12s3.5-7 9-7 9 7 9 7-3.5 7-9 7-9-7-9-7Z" /><circle cx="12" cy="12" r="3" /></svg>
                            </button>
                        </div>
                        <div class="product-info">
                            <span class="product-name">@item.Title</span>
                            <span class="product-price">@("R" + item.Price) <span class="store">@item.Retailer</span></span>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>

@section scripts {

    <!-- Same product-thumb / fav-btn styling as the Main catalogue page, so a
         favourited card looks identical here. Only added because that styling
         lives inline on the Main view rather than in a shared stylesheet. -->
    <style>
        .catalog-empty {
            text-align: center;
            color: var(--text-muted, #64748b);
            padding: 40px 0;
        }

        .category-title {
            display: flex;
            align-items: baseline;
            gap: 8px;
        }

        .category-count {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-muted, #64748b);
        }

        .product-thumb {
            position: relative;
            isolation: isolate;
        }

            .product-thumb img {
                position: absolute;
                top: 0;
                left: 0;
                z-index: -1;
                width: 100%;
                height: 100%;
                box-sizing: border-box;
                padding: 10px;
                object-fit: contain;
            }

        .fav-btn {
            position: absolute;
            top: 8px;
            right: 8px;
            z-index: 2;
            width: 32px;
            height: 32px;
            padding: 0;
            border: none;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.92);
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
            color: #94a3b8;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

            .fav-btn svg {
                width: 18px;
                height: 18px;
                fill: none;
                stroke: currentColor;
                stroke-width: 2;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

            .fav-btn:hover {
                color: #e11d48;
            }

            .fav-btn.active {
                color: #e11d48;
            }

                .fav-btn.active svg {
                    fill: currentColor;
                }

            .fav-btn:disabled {
                opacity: 0.6;
                cursor: wait;
            }

            .fav-btn:focus-visible {
                outline: 2px solid #16a34a;
                outline-offset: 2px;
            }

        .undislike-btn {
            position: absolute;
            top: 8px;
            right: 8px;
            z-index: 2;
            width: 32px;
            height: 32px;
            padding: 0;
            border: none;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.92);
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
            color: #94a3b8;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

            .undislike-btn svg {
                width: 18px;
                height: 18px;
                fill: none;
                stroke: currentColor;
                stroke-width: 2;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

            .undislike-btn:hover {
                color: #16a34a;
            }

            .undislike-btn:disabled {
                opacity: 0.6;
                cursor: wait;
            }

            .undislike-btn:focus-visible {
                outline: 2px solid #16a34a;
                outline-offset: 2px;
            }

        /* Card removal animation when a favourite is un-hearted on this page. */
        .product-card.removing {
            opacity: 0;
            transform: scale(0.92);
            transition: opacity 0.25s ease, transform 0.25s ease;
        }
    </style>

    <script>
        if (!window.jQuery) {
            document.write('<scr' + 'ipt src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></scr' + 'ipt>');
        }
    </script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.js"></script>

    <script>
        toastr.options = {
            "closeButton": true,
            "debug": false,
            "newestOnTop": false,
            "progressBar": false,
            "positionClass": "toast-top-full-width",
            "preventDuplicates": false,
            "showDuration": "300",
            "hideDuration": "1000",
            "timeOut": "6000",
            "extendedTimeOut": "1000",
            "showEasing": "swing",
            "hideEasing": "linear",
            "showMethod": "fadeIn",
            "hideMethod": "fadeOut"
        };

        function showToast(message, type) {
            var method = type === 'over' ? 'error' : type === 'success' ? 'success' : 'info';
            toastr[method](message, '', { timeOut: type === 'success' ? 2500 : 6000 });
        }

        // Same ToggleFavourite endpoint the Main page uses, plus a fallback for a
        // favourite whose product is no longer in the live catalogue.
        var TOGGLE_FAV_URL = '@Url.Action("ToggleFavourite", "Home")';
        var REMOVE_FAV_URL = '@Url.Action("RemoveFavourite", "Home")';
        var REMOVE_DISLIKE_URL = '@Url.Action("RemoveDislike", "Home")';

        // Shared by the Favourites grid and the Hidden Products grid: removes the
        // card, updates that section's count, and swaps in the empty-state message
        // once its grid is empty.
        function removeCardFromGrid(card, gridId, countId, emptyId, emptyText) {
            card.classList.add('removing');
            card.addEventListener('transitionend', function () {
                card.remove();

                var grid = document.getElementById(gridId);
                var countEl = document.getElementById(countId);
                var remaining = grid ? grid.querySelectorAll('.product-card').length : 0;
                if (countEl) countEl.textContent = remaining;

                if (remaining === 0 && grid) {
                    var empty = document.createElement('p');
                    empty.className = 'catalog-empty';
                    empty.id = emptyId;
                    empty.textContent = emptyText;
                    grid.replaceWith(empty);
                }
            }, { once: true });
        }

        // Mirrors Main.cshtml's toggleFavourite(): same request shape, same
        // toast pattern. The only difference is that on this page a successful
        // response always means "remove the card", since everything shown here
        // already is a favourite.
        function toggleFavourite(btn) {
            var tokenInput = document.querySelector('#fav-token input[name="__RequestVerificationToken"]');
            var scrapedId = btn.getAttribute('data-id');
            var favoriteId = btn.getAttribute('data-favorite-id');

            var url = scrapedId ? TOGGLE_FAV_URL : REMOVE_FAV_URL;
            var body = scrapedId
                ? 'id=' + encodeURIComponent(scrapedId)
                : 'favoriteId=' + encodeURIComponent(favoriteId);
            body += '&__RequestVerificationToken=' + encodeURIComponent(tokenInput ? tokenInput.value : '');

            btn.disabled = true;
            fetch(url, {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: body
            })
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    if (!data.success) {
                        showToast(data.message || 'Could not update favourites.', 'over');
                        btn.disabled = false;
                        return;
                    }
                    showToast('Removed from favourites', 'success');
                    removeCardFromGrid(
                        btn.closest('.product-card'),
                        'fav-grid',
                        'fav-count',
                        'fav-empty',
                        "You haven't favourited anything yet. Tap the heart on a product in the catalogue to save it here."
                    );
                })
                .catch(function () {
                    showToast('Something went wrong. Please try again.', 'over');
                    btn.disabled = false;
                });
        }

        // Mirrors toggleFavourite() above: removes the dislike row so the product
        // is eligible to show up in the catalogue again.
        function undislikeProduct(btn) {
            var tokenInput = document.querySelector('#fav-token input[name="__RequestVerificationToken"]');
            var dislikedId = btn.getAttribute('data-disliked-id');

            btn.disabled = true;
            fetch(REMOVE_DISLIKE_URL, {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: 'dislikedItemId=' + encodeURIComponent(dislikedId) +
                      '&__RequestVerificationToken=' + encodeURIComponent(tokenInput ? tokenInput.value : '')
            })
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    if (!data.success) {
                        showToast(data.message || 'Could not update hidden products.', 'over');
                        btn.disabled = false;
                        return;
                    }
                    showToast('Product will show up in the catalogue again', 'success');
                    removeCardFromGrid(
                        btn.closest('.product-card'),
                        'disliked-grid',
                        'disliked-count',
                        'disliked-empty',
                        'You haven\'t hidden any products yet. Right-click (or long-press) a product in the catalogue and choose "I don\'t want to see this product again".'
                    );
                })
                .catch(function () {
                    showToast('Something went wrong. Please try again.', 'over');
                    btn.disabled = false;
                });
        }

        document.addEventListener('DOMContentLoaded', function () {
            var body = document.querySelector('.page-body');
            if (!body) return;

            body.addEventListener('click', function (e) {
                var favBtn = e.target.closest('.fav-btn');
                if (favBtn && !favBtn.disabled) { toggleFavourite(favBtn); return; }

                var undislikeBtn = e.target.closest('.undislike-btn');
                if (undislikeBtn && !undislikeBtn.disabled) undislikeProduct(undislikeBtn);
            });
        });
    </script>
}
