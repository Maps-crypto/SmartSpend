            }

        @@keyframes ai-shimmer {
            from {
                background-position: 200% 0;
            }

            to {
                background-position: -200% 0;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .ai-skeleton .sk-thumb,
            .ai-skeleton .sk-line {
                animation: none;
            }
        }

        /* ---------- Onboarding: budget nudge ---------- */
        .budget-nudge-hint {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            margin: 0 0 10px;
            padding: 9px 12px;
            border-radius: 10px;
            background: rgba(22, 163, 74, 0.1);
            color: #15803d;
            font-size: 13px;
            font-weight: 600;
            line-height: 1.35;
            text-align: left;
        }

            .budget-nudge-hint svg {
                width: 16px;
                height: 16px;
                flex-shrink: 0;
                margin-top: 1px;
                animation: budget-arrow-bounce 1s ease-in-out infinite;
            }

        /* Steady green ring + a soft pulse that radiates outward until the user types */
        .budget-set-box.nudge .budget-set-row {
            border-radius: 12px;
            outline: 2px solid #16a34a;
            outline-offset: 2px;
            animation: budget-nudge-pulse 1.6s ease-out infinite;
        }

        .budget-set-box.nudge.has-value .budget-set-row {
            animation: none;
        }

        .budget-set-box.nudge.has-value .budget-nudge-hint svg {
            animation: none;
        }

        /* Header cart button keeps pulsing if the drawer is closed before a budget is set */
        .icon-btn.nudge-pulse {
            border-radius: 50%;
            animation: budget-nudge-pulse 1.6s ease-out infinite;
        }

        @@keyframes budget-nudge-pulse {
            0% {
                box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.55);
            }

            70%, 100% {
                box-shadow: 0 0 0 12px rgba(22, 163, 74, 0);
            }
        }

        @@keyframes budget-arrow-bounce {
            0%, 100% {
                transform: translateY(-2px);
            }

            50% {
                transform: translateY(3px);
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .budget-set-box.nudge .budget-set-row,
            .icon-btn.nudge-pulse,
            .budget-nudge-hint svg {
                animation: none;
            }
        }

        /* ---------- Category FABs (bottom right) ---------- */
        .category-fabs {
            position: fixed;
            right: 2px;
            bottom: calc(16px + env(safe-area-inset-bottom, 0px));
            z-index: 30;
            display: flex;
            flex-direction: column;
            gap: 10px;
            max-height: 85vh;
            overflow-y: auto;
            padding: 10px 12px;
            scrollbar-width: none;
        }

            .category-fabs::-webkit-scrollbar {
                display: none;
            }

        .category-fab {
            width: 60px;
            height: 60px;
            padding: 0;
            border: 1px solid rgba(0, 0, 0, 0.08);
            border-radius: 50%;
            background: #fff;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.16);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            flex-shrink: 0;
            font-family: inherit;
            cursor: pointer;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }

            .category-fab:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 12px rgba(0, 0, 0, 0.22);
            }

            .category-fab:active {
                transform: scale(0.95);
            }

            .category-fab img {
                width: 35px;
                height: 35px;
                object-fit: contain;
                display: block;
                border-radius: 50%;
            }

        /* Back to top: collapsed (zero height, no gap) until the page is scrolled,
           then it grows in below the category buttons and they glide up to make room. */
        .back-to-top {
            max-height: 0;
            margin-top: -10px;
            border-width: 0;
            box-shadow: none;
            opacity: 0;
            transform: scale(0.6);
            pointer-events: none;
            transition: max-height 0.2s ease, margin-top 0.2s ease, opacity 0.2s ease, transform 0.2s ease, box-shadow 0.15s ease;
        }

            .back-to-top.visible {
                max-height: 60px;
                margin-top: 0;
                border-width: 1px;
                box-shadow: 0 3px 10px rgba(0, 0, 0, 0.16);
                opacity: 1;
                transform: none;
                pointer-events: auto;
            }

                .back-to-top.visible:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 5px 12px rgba(0, 0, 0, 0.22);
                }

                .back-to-top.visible:active {
                    transform: scale(0.95);
                }

        @@media (max-width: 480px) {
            .category-fabs {
                right: 0;
                padding: 8px;
                gap: 8px;
            }

            .category-fab {
                width: 34px;
                height: 34px;
            }

            .back-to-top {
                margin-top: -8px;
            }

            .category-fab img {
                width: 22px;
                height: 22px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .category-fab,
            .back-to-top {
                transition: none;
            }
        }

        /* ---------- Distance filter modal ---------- */
        body.dist-modal-open {
            overflow: hidden;
        }

        .dist-modal {
            position: fixed;
            inset: 0;
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
        }

            .dist-modal[hidden] {
                display: none;
            }

        .dist-backdrop {
            position: absolute;
            inset: 0;
            background: rgba(15, 23, 42, 0.55);
        }

        .dist-dialog {
            position: relative;
            display: flex;
            flex-direction: column;
            width: min(720px, 100%);
            max-height: min(92vh, 880px);
            background: var(--surface, #fff);
            color: var(--text, #0f172a);
            border-radius: 14px;
            box-shadow: 0 20px 50px rgba(15, 23, 42, 0.3);
            overflow: hidden;
        }

        .dist-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            padding: 16px 18px 12px;
            border-bottom: 1px solid var(--border, #e2e8f0);
        }

        .dist-head-text {
            min-width: 0;
        }

        .dist-head h2 {
            margin: 0;
            font-size: 17px;
            font-weight: 700;
        }

        .dist-sub {
            margin: 4px 0 0;
            font-size: 12.5px;
            color: var(--text-muted, #64748b);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .dist-x {
            flex-shrink: 0;
            width: 32px;
            height: 32px;
            border: none;
            border-radius: 8px;
            background: none;
            font-size: 24px;
            line-height: 1;
            color: var(--text-muted, #64748b);
            cursor: pointer;
        }

            .dist-x:hover {
                background: var(--surface-hover, #f1f5f9);
            }

        .dist-body {
            padding: 14px 18px;
            overflow-y: auto;
        }

        .dist-map-wrap {
            position: relative;
            border: 1px solid var(--border, #e2e8f0);
            border-radius: 10px;
            overflow: hidden;
            background: #e5e7eb;
        }

        .dist-map {
            width: 100%;
            height: 320px;
        }

        .dist-map-msg {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 20px;
            text-align: center;
            font-size: 14px;
            background: rgba(255, 255, 255, 0.92);
            color: #0f172a;
        }

            .dist-map-msg[hidden] {
                display: none;
            }

        .dist-spinner {
            width: 22px;
            height: 22px;
            border: 3px solid #cbd5e1;
            border-top-color: #16a34a;
            border-radius: 50%;
            animation: dist-spin 0.8s linear infinite;
        }

        @@keyframes dist-spin {
            to {
                transform: rotate(360deg);
            }
        }

        .dist-radius {
            display: flex;
            gap: 6px;
            margin-top: 14px;
            padding: 3px;
            background: var(--surface-hover, #f1f5f9);
            border-radius: 999px;
        }

        .dist-radius-btn {
            flex: 1;
            padding: 8px 6px;
            border: none;
            border-radius: 999px;
            background: none;
            font-size: 13.5px;
            font-weight: 600;
            color: var(--text-muted, #64748b);
            cursor: pointer;
        }

            .dist-radius-btn.active {
                background: var(--surface, #fff);
                color: var(--accent, #16a34a);
                box-shadow: 0 1px 3px rgba(15, 23, 42, 0.18);
            }

        .dist-within {
            margin: 16px 0 8px;
            font-size: 14px;
            font-weight: 700;
        }

        .dist-retailers {
            list-style: none;
            margin: 0;
            padding: 0;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .dist-retailer {
            display: grid;
            grid-template-columns: auto 1fr auto;
            align-items: center;
            column-gap: 8px;
            row-gap: 2px;
            padding: 9px 11px;
            border: 1px solid var(--border, #e2e8f0);
            border-radius: 10px;
            font-size: 13.5px;
        }

        .dist-retailer-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }

        .dist-retailer-name {
            font-weight: 600;
        }

        .dist-retailer-mark {
            font-weight: 700;
        }

        .dist-retailer.is-in .dist-retailer-mark {
            color: #16a34a;
        }

        .dist-retailer.is-out {
            color: var(--text-muted, #64748b);
        }

            .dist-retailer.is-out .dist-retailer-mark {
                color: #dc2626;
            }

        .dist-retailer-detail {
            grid-column: 2 / 4;
            font-size: 12px;
            color: var(--text-muted, #64748b);
        }

        .dist-note {
            margin: 12px 0 0;
            padding: 9px 12px;
            border-radius: 8px;
            background: #fef3c7;
            color: #92400e;
            font-size: 13px;
        }

            .dist-note[hidden] {
                display: none;
            }

        .dist-foot {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 12px 18px;
            border-top: 1px solid var(--border, #e2e8f0);
        }

        .dist-spacer {
            flex: 1;
        }

        .dist-btn {
            padding: 9px 16px;
            border: 1px solid var(--border, #e2e8f0);
            border-radius: 8px;
            background: var(--surface, #fff);
            color: var(--text, #0f172a);
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
        }

            .dist-btn:hover:not(:disabled) {
                background: var(--surface-hover, #f1f5f9);
            }

            .dist-btn:disabled {
                opacity: 0.5;
                cursor: not-allowed;
            }

        .dist-btn-primary {
            border-color: #16a34a;
            background: #16a34a;
            color: #fff;
        }

            .dist-btn-primary:hover:not(:disabled) {
                background: #15803d;
            }

        .dist-btn-link {
            border-color: transparent;
            background: none;
            color: var(--text-muted, #64748b);
            text-decoration: underline;
        }

            .dist-btn-link[hidden] {
                display: none;
            }

        .dist-x:focus-visible,
        .dist-radius-btn:focus-visible,
        .dist-btn:focus-visible {
            outline: 2px solid #16a34a;
            outline-offset: 2px;
        }

        /* Map pins (custom AdvancedMarker content) */
        .dist-pin {
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #fff;
            border-radius: 50%;
            box-shadow: 0 1px 4px rgba(15, 23, 42, 0.45);
            color: #fff;
            font-size: 12px;
            font-weight: 700;
            box-sizing: border-box;
        }

        .dist-pin-you {
            box-shadow: 0 0 0 6px rgba(37, 99, 235, 0.25), 0 1px 4px rgba(15, 23, 42, 0.45);
        }

        .dist-info {
            font-size: 13px;
            color: #0f172a;
            max-width: 220px;
        }

        .dist-info-km {
            margin-top: 2px;
            color: #16a34a;
            font-weight: 600;
        }

        @@media (max-width: 520px) {
            .dist-modal {
                padding: 8px;
            }

            .dist-map {
                height: 260px;
            }

            .dist-retailers {
                grid-template-columns: 1fr;
            }
        }

        /* ---------- Shopping list: store branch + estimated travel costs ---------- */
        .travel-block {
            margin: 10px 0 4px;
        }

        .branch-pick {
            display: flex;
            align-items: center;
            gap: 8px;
            width: 100%;
            padding: 9px 12px;
            border: 1px solid var(--border, #e2e8f0);
            border-radius: 10px;
            background: var(--surface, #fff);
            color: var(--text, #0f172a);
            font: inherit;
            font-size: 13.5px;
            font-weight: 600;
            text-align: left;
            cursor: pointer;
        }

            .branch-pick:hover {
                border-color: #16a34a;
                background: var(--surface-hover, #f1f5f9);
            }

            .branch-pick:focus-visible,
            .travel-retry:focus-visible,
            .branch-item:focus-visible,
            .branch-origin-select:focus-visible {
                outline: 2px solid #16a34a;
                outline-offset: 2px;
            }

            .branch-pick svg {
                flex-shrink: 0;
                width: 16px;
                height: 16px;
                color: #16a34a;
            }

        .branch-pick-name {
            flex: 1;
            min-width: 0;
            text-decoration: underline;
            text-decoration-style: dotted;
            text-underline-offset: 3px;
        }

        .branch-pick-caret {
            color: var(--text-muted, #64748b);
        }

        .branch-meta {
            margin: 6px 2px 0;
            font-size: 12.5px;
            color: var(--text-muted, #64748b);
        }

            .branch-meta strong {
                color: var(--text, #0f172a);
                font-size: 14px;
            }

        .travel-msg {
            margin: 4px 0;
            font-size: 12.5px;
