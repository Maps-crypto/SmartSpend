        .travel-note {
            margin: 6px 2px 0;
            font-size: 11.5px;
            line-height: 1.4;
            color: var(--text-muted, #64748b);
        }

        .store-group .transport-options {
            flex-wrap: wrap;
        }

        .transport-pill:disabled {
            opacity: 0.55;
            cursor: not-allowed;
        }

        /* Branch modal (sits above the shopping-list drawer) */
        #branch-modal {
            z-index: 1100;
        }

        .branch-origin-row {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
            font-size: 13px;
            font-weight: 600;
        }

        .branch-origin-select {
            flex: 1;
            min-width: 0;
            padding: 7px 10px;
            border: 1px solid var(--border, #e2e8f0);
